# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/mini-lending-ops

# JWT secret key (use a long random string in production)
JWT_SECRET=your_jwt_secret_here

# Email provider API key (Resend or Brevo)
EMAIL_API_KEY=your_email_api_key_here

# From email address (must be verified in your email provider)
EMAIL_FROM=noreply@yourdomain.com

# Backend server port
PORT=5000

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
